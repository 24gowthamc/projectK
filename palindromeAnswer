 public static int solvePalindrome(String s) {
        int i = 0;
        int j = s.length() - 1;
        int changes = 0;

        while (i < j) {
            if (s.charAt(i) != s.charAt(j)) {
                // one replacement is enough to make this pair equal
                changes++;
            }
            i++;
            j--;
        }

        return changes;
    }
