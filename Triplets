int solution(String text) {
    if (text == null || text.length() < 3) {
        return 0;
    }

    text = text.toLowerCase(); // case-insensitive comparison
    int count = 0;

    for (int i = 0; i <= text.length() - 3; i++) {
        if (text.charAt(i) == text.charAt(i + 2)) {
            count++;
        }
    }

    return count;
}
